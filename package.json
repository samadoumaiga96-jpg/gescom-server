{
  "name": "gescom-licence-server",
  "version": "1.0.0",
  "description": "Serveur de validation de licences GESCOM — à déployer sur un hébergement Node (Render, Railway, VPS, etc.)",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "migrate": "node -e \"require('dotenv').config();const fs=require('fs');const {pool}=require('./db');pool.query(fs.readFileSync('./schema.sql','utf8')).then(()=>{console.log('Schéma appliqué.');process.exit(0);}).catch(e=>{console.error(e);process.exit(1);});\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0"
  }
}
